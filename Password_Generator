<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SecureVault - Password Manager</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo {
            font-size: 2.5rem;
            font-weight: bold;
            color: white;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.2rem;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }

        .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            height: fit-content;
        }

        .main-content {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #2c3e50;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e1e8ed;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: white;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .checkbox-item input[type="checkbox"] {
            width: auto;
            margin: 0;
        }

        .slider-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .slider {
            flex: 1;
        }

        .slider-value {
            background: #3498db;
            color: white;
            padding: 5px 10px;
            border-radius: 15px;
            font-weight: bold;
            min-width: 40px;
            text-align: center;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
        }

        .btn-success {
            background: linear-gradient(135deg, #27ae60, #229954);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .password-display {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 15px;
            font-family: 'Courier New', monospace;
            font-size: 1.2rem;
            word-break: break-all;
            margin: 20px 0;
            position: relative;
        }

        .strength-meter {
            height: 8px;
            background: #e9ecef;
            border-radius: 4px;
            margin: 10px 0;
            overflow: hidden;
        }

        .strength-bar {
            height: 100%;
            transition: all 0.3s ease;
            border-radius: 4px;
        }

        .passwords-list {
            max-height: 600px;
            overflow-y: auto;
        }

        .password-item {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .password-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .password-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .app-name {
            font-weight: bold;
            font-size: 1.1rem;
            color: #2c3e50;
        }

        .date-time {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

        .password-preview {
            font-family: 'Courier New', monospace;
            background: white;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #dee2e6;
            margin: 10px 0;
            position: relative;
        }

        .password-actions {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 0.8rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            display: block;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .search-box {
            position: relative;
            margin-bottom: 20px;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #7f8c8d;
        }

        .search-box input {
            padding-left: 40px;
        }

        .copy-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: #3498db;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.8rem;
        }

        .tabs {
            display: flex;
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 20px;
        }

        .tab {
            padding: 10px 20px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .tab.active {
            border-bottom-color: #3498db;
            color: #3498db;
            font-weight: bold;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .export-btn {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
        }

        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">🔐 SecureVault</div>
            <div class="subtitle">Advanced Password Manager & Generator</div>
        </header>

        <div class="dashboard">
            <div class="sidebar">
                <h2 class="section-title">🔧 Password Generator</h2>
                
                <div class="form-group">
                    <label for="appName">Application Name</label>
                    <input type="text" id="appName" placeholder="e.g., Gmail, Facebook, etc.">
                </div>

                <div class="form-group">
                    <label for="passwordLength">Password Length</label>
                    <div class="slider-group">
                        <input type="range" id="passwordLength" class="slider" min="4" max="128" value="16">
                        <span class="slider-value" id="lengthValue">16</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Character Types</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="checkbox" id="uppercase" checked>
                            <label for="uppercase">A-Z</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="lowercase" checked>
                            <label for="lowercase">a-z</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="numbers" checked>
                            <label for="numbers">0-9</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="symbols" checked>
                            <label for="symbols">!@#$</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="excludeChars">Exclude Characters</label>
                    <input type="text" id="excludeChars" placeholder="e.g., 0Oo1Il">
                </div>

                <div class="password-display" id="passwordDisplay">
                    Click "Generate Password" to create a secure password
                    <button class="copy-btn" id="copyBtn" style="display: none;">Copy</button>
                </div>

                <div class="strength-meter">
                    <div class="strength-bar" id="strengthBar"></div>
                </div>
                <div id="strengthText">Password strength will appear here</div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="generateBtn">🎲 Generate</button>
                    <button class="btn btn-success" id="saveBtn" disabled>💾 Save</button>
                </div>
            </div>

            <div class="main-content">
                <div class="tabs">
                    <div class="tab active" data-tab="dashboard">📊 Dashboard</div>
                    <div class="tab" data-tab="passwords">🔑 Passwords</div>
                    <div class="tab" data-tab="settings">⚙️ Settings</div>
                </div>

                <div class="tab-content active" id="dashboard">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <span class="stat-number" id="totalPasswords">0</span>
                            <span class="stat-label">Total Passwords</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="strongPasswords">0</span>
                            <span class="stat-label">Strong Passwords</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="recentPasswords">0</span>
                            <span class="stat-label">This Month</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="avgStrength">0%</span>
                            <span class="stat-label">Avg Strength</span>
                        </div>
                    </div>

                    <h3 class="section-title">📈 Recent Activity</h3>
                    <div id="recentActivity">
                        <p style="text-align: center; color: #7f8c8d; font-style: italic; padding: 40px;">
                            No passwords generated yet. Create your first password to see activity here.
                        </p>
                    </div>
                </div>

                <div class="tab-content" id="passwords">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" placeholder="Search passwords...">
                    </div>
                    
                    <div class="btn-group" style="margin-bottom: 20px;">
                        <button class="btn export-btn" id="exportBtn">📤 Export All</button>
                        <button class="btn btn-danger" id="clearAllBtn">🗑️ Clear All</button>
                    </div>

                    <div class="passwords-list" id="passwordsList">
                        <p style="text-align: center; color: #7f8c8d; font-style: italic; padding: 40px;">
                            No saved passwords yet. Generate and save passwords to see them here.
                        </p>
                    </div>
                </div>

                <div class="tab-content" id="settings">
                    <h3 class="section-title">🔧 Application Settings</h3>
                    
                    <div class="form-group">
                        <label for="autoSave">
                            <input type="checkbox" id="autoSave" style="width: auto; margin-right: 10px;">
                            Auto-save generated passwords
                        </label>
                    </div>
                    
                    <div class="form-group">
                        <label for="showStrength">
                            <input type="checkbox" id="showStrength" checked style="width: auto; margin-right: 10px;">
                            Show password strength in list
                        </label>
                    </div>
                    
                    <div class="form-group">
                        <label for="defaultLength">Default Password Length</label>
                        <select id="defaultLength">
                            <option value="12">12 characters</option>
                            <option value="16" selected>16 characters</option>
                            <option value="20">20 characters</option>
                            <option value="24">24 characters</option>
                            <option value="32">32 characters</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="themeSelect">Theme</label>
                        <select id="themeSelect">
                            <option value="blue" selected>Ocean Blue</option>
                            <option value="dark">Dark Mode</option>
                            <option value="green">Forest Green</option>
                            <option value="purple">Royal Purple</option>
                        </select>
                    </div>

                    <button class="btn btn-primary" id="saveSettings">💾 Save Settings</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        class PasswordManager {
            constructor() {
                this.passwords = JSON.parse(localStorage.getItem('savedPasswords')) || [];
                this.settings = JSON.parse(localStorage.getItem('appSettings')) || {
                    autoSave: false,
                    showStrength: true,
                    defaultLength: 16,
                    theme: 'blue'
                };
                this.currentPassword = '';
                this.init();
            }

            init() {
                this.bindEvents();
                this.loadSettings();
                this.updateStats();
                this.renderPasswordsList();
                this.renderRecentActivity();
            }

            bindEvents() {
                // Password length slider
                document.getElementById('passwordLength').addEventListener('input', (e) => {
                    document.getElementById('lengthValue').textContent = e.target.value;
                });

                // Generate password
                document.getElementById('generateBtn').addEventListener('click', () => {
                    this.generatePassword();
                });

                // Save password
                document.getElementById('saveBtn').addEventListener('click', () => {
                    this.savePassword();
                });

                // Copy password
                document.getElementById('copyBtn').addEventListener('click', () => {
                    this.copyPassword();
                });

                // Tab switching
                document.querySelectorAll('.tab').forEach(tab => {
                    tab.addEventListener('click', (e) => {
                        this.switchTab(e.target.dataset.tab);
                    });
                });

                // Search functionality
                document.getElementById('searchInput').addEventListener('input', (e) => {
                    this.searchPasswords(e.target.value);
                });

                // Export passwords
                document.getElementById('exportBtn').addEventListener('click', () => {
                    this.exportPasswords();
                });

                // Clear all passwords
                document.getElementById('clearAllBtn').addEventListener('click', () => {
                    if (confirm('Are you sure you want to delete all passwords? This action cannot be undone.')) {
                        this.clearAllPasswords();
                    }
                });

                // Save settings
                document.getElementById('saveSettings').addEventListener('click', () => {
                    this.saveSettings();
                });
            }

            generatePassword() {
                const length = parseInt(document.getElementById('passwordLength').value);
                const includeUppercase = document.getElementById('uppercase').checked;
                const includeLowercase = document.getElementById('lowercase').checked;
                const includeNumbers = document.getElementById('numbers').checked;
                const includeSymbols = document.getElementById('symbols').checked;
                const excludeChars = document.getElementById('excludeChars').value;

                let charset = '';
                if (includeUppercase) charset += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                if (includeLowercase) charset += 'abcdefghijklmnopqrstuvwxyz';
                if (includeNumbers) charset += '0123456789';
                if (includeSymbols) charset += '!@#$%^&*()_+-=[]{}|;:,.<>?';

                // Remove excluded characters
                if (excludeChars) {
                    for (let char of excludeChars) {
                        charset = charset.replace(new RegExp(char.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), '');
                    }
                }

                if (!charset) {
                    alert('Please select at least one character type!');
                    return;
                }

                let password = '';
                
                // Ensure at least one character from each selected type
                const types = [];
                if (includeUppercase) types.push('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
                if (includeLowercase) types.push('abcdefghijklmnopqrstuvwxyz');
                if (includeNumbers) types.push('0123456789');
                if (includeSymbols) types.push('!@#$%^&*()_+-=[]{}|;:,.<>?');

                // Add one character from each type
                types.forEach(type => {
                    let availableChars = type;
                    if (excludeChars) {
                        for (let char of excludeChars) {
                            availableChars = availableChars.replace(new RegExp(char.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), '');
                        }
                    }
                    if (availableChars) {
                        password += availableChars.charAt(Math.floor(Math.random() * availableChars.length));
                    }
                });

                // Fill the rest randomly
                for (let i = password.length; i < length; i++) {
                    password += charset.charAt(Math.floor(Math.random() * charset.length));
                }

                // Shuffle the password
                password = password.split('').sort(() => Math.random() - 0.5).join('');

                this.currentPassword = password;
                this.displayPassword(password);
                this.calculateStrength(password);
                
                document.getElementById('saveBtn').disabled = false;
                document.getElementById('copyBtn').style.display = 'block';

                if (this.settings.autoSave && document.getElementById('appName').value.trim()) {
                    this.savePassword();
                }
            }

            displayPassword(password) {
                const display = document.getElementById('passwordDisplay');
                display.textContent = password;
                display.style.backgroundColor = '#e8f5e8';
                display.style.border = '2px solid #27ae60';
            }

            calculateStrength(password) {
                let score = 0;
                let feedback = [];

                // Length
                if (password.length >= 8) score += 20;
                if (password.length >= 12) score += 10;
                if (password.length >= 16) score += 10;

                // Character variety
                if (/[a-z]/.test(password)) score += 10;
                if (/[A-Z]/.test(password)) score += 10;
                if (/[0-9]/.test(password)) score += 10;
                if (/[^A-Za-z0-9]/.test(password)) score += 15;

                // Complexity
                if (password.length >= 16 && /[a-z]/.test(password) && /[A-Z]/.test(password) && /[0-9]/.test(password) && /[^A-Za-z0-9]/.test(password)) {
                    score += 15;
                }

                const strengthBar = document.getElementById('strengthBar');
                const strengthText = document.getElementById('strengthText');

                let strengthLevel = '';
                let color = '';

                if (score < 30) {
                    strengthLevel = 'Very Weak';
                    color = '#e74c3c';
                } else if (score < 50) {
                    strengthLevel = 'Weak';
                    color = '#f39c12';
                } else if (score < 70) {
                    strengthLevel = 'Good';
                    color = '#f1c40f';
                } else if (score < 90) {
                    strengthLevel = 'Strong';
                    color = '#27ae60';
                } else {
                    strengthLevel = 'Very Strong';
                    color = '#2ecc71';
                }

                strengthBar.style.width = `${Math.min(score, 100)}%`;
                strengthBar.style.backgroundColor = color;
                strengthText.textContent = `Strength: ${strengthLevel} (${Math.min(score, 100)}%)`;
                strengthText.style.color = color;

                return { score: Math.min(score, 100), level: strengthLevel };
            }

            savePassword() {
                const appName = document.getElementById('appName').value.trim();
                if (!appName) {
                    alert('Please enter an application name!');
                    return;
                }

                if (!this.currentPassword) {
                    alert('Please generate a password first!');
                    return;
                }

                const strength = this.calculateStrength(this.currentPassword);
                const passwordData = {
                    id: Date.now(),
                    appName: appName,
                    password: this.currentPassword,
                    strength: strength,
                    dateCreated: new Date().toISOString(),
                    dateFormatted: new Date().toLocaleString()
                };

                this.passwords.unshift(passwordData);
                localStorage.setItem('savedPasswords', JSON.stringify(this.passwords));

                // Clear form
                document.getElementById('appName').value = '';
                document.getElementById('passwordDisplay').textContent = 'Password saved successfully!';
                document.getElementById('passwordDisplay').style.backgroundColor = '#d4edda';
                document.getElementById('passwordDisplay').style.border = '2px solid #27ae60';
                document.getElementById('copyBtn').style.display = 'none';
                document.getElementById('saveBtn').disabled = true;

                this.updateStats();
                this.renderPasswordsList();
                this.renderRecentActivity();

                setTimeout(() => {
                    document.getElementById('passwordDisplay').textContent = 'Click "Generate Password" to create a secure password';
                    document.getElementById('passwordDisplay').style.backgroundColor = '#f8f9fa';
                    document.getElementById('passwordDisplay').style.border = '2px solid #e9ecef';
                }, 3000);
            }

            copyPassword() {
                if (this.currentPassword) {
                    navigator.clipboard.writeText(this.currentPassword).then(() => {
                        const copyBtn = document.getElementById('copyBtn');
                        const originalText = copyBtn.textContent;
                        copyBtn.textContent = 'Copied!';
                        copyBtn.style.backgroundColor = '#27ae60';
                        
                        setTimeout(() => {
                            copyBtn.textContent = originalText;
                            copyBtn.style.backgroundColor = '#3498db';
                        }, 2000);
                    });
                }
            }

            copyPasswordFromList(password) {
                navigator.clipboard.writeText(password).then(() => {
                    // Visual feedback could be added here
                });
            }

            deletePassword(id) {
                if (confirm('Are you sure you want to delete this password?')) {
                    this.passwords = this.passwords.filter(p => p.id !== id);
                    localStorage.setItem('savedPasswords', JSON.stringify(this.passwords));
                    this.updateStats();
                    this.renderPasswordsList();
                    this.renderRecentActivity();
                }
            }

            updateStats() {
                const total = this.passwords.length;
                const strong = this.passwords.filter(p => p.strength.score >= 70).length;
                const thisMonth = this.passwords.filter(p => {
                    const passwordDate = new Date(p.dateCreated);
                    const now = new Date();
                    return passwordDate.getMonth() === now.getMonth() && passwordDate.getFullYear() === now.getFullYear();
                }).length;
                
                const avgStrength = total > 0 ? Math.round(this.passwords.reduce((sum, p) => sum + p.strength.score, 0) / total) : 0;

                document.getElementById('totalPasswords').textContent = total;
                document.getElementById('strongPasswords').textContent = strong;
                document.getElementById('recentPasswords').textContent = thisMonth;
                document.getElementById('avgStrength').textContent = avgStrength + '%';
            }

            renderPasswordsList() {
                const container = document.getElementById('passwordsList');
                
                if (this.passwords.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: #7f8c8d; font-style: italic; padding: 40px;">No saved passwords yet. Generate and save passwords to see them here.</p>';
                    return;
                }

                container.innerHTML = this.passwords.map(pwd => `
                    <div class="password-item">
                        <div class="password-header">
                            <span class="app-name">🔗 ${pwd.appName}</span>
                            <span class="date-time">${pwd.dateFormatted}</span>
                        </div>
                        <div class="password-preview">
                            <span style="font-family: monospace; font-size: 1.1rem;">${'•'.repeat(pwd.password.length)}</span>
                            <button class="copy-btn" onclick="passwordManager.copyPasswordFromList('${pwd.password}')">Copy</button>
                        </div>
                        ${this.settings.showStrength ? `
                            <div style="margin: 10px 0;">
                                <small style="color: ${this.getStrengthColor(pwd.strength.score)};">
                                    Strength: ${pwd.strength.level} (${pwd.strength.score}%)
                                </small>
                                <div class="strength-meter" style="height: 4px; margin-top: 5px;">
                                    <div class="strength-bar" style="width: ${pwd.strength.score}%; background-color: ${this.getStrengthColor(pwd.strength.score)};"></div>
                                </div>
                            </div>
                        ` : ''}
                        <div class="password-actions">
                            <button class="btn btn-primary btn-small" onclick="passwordManager.showPassword(${pwd.id})">👁️ Show</button>
                            <button class="btn btn-danger btn-small" onclick="passwordManager.deletePassword(${pwd.id})">🗑️ Delete</button>
                        </div>
                    </div>
                `).join('');
            }

            showPassword(id) {
                const password = this.passwords.find(p => p.id === id);
                if (password) {
                    const passwordPreview = document.querySelector(`[onclick="passwordManager.showPassword(${id})"]`).closest('.password-item').querySelector('.password-preview span');
                    const isHidden = passwordPreview.textContent.includes('•');
                    
                    if (isHidden) {
                        passwordPreview.textContent = password.password;
                        document.querySelector(`[onclick="passwordManager.showPassword(${id})"]`).innerHTML = '🙈 Hide';
                    } else {
                        passwordPreview.textContent = '•'.repeat(password.password.length);
                        document.querySelector(`[onclick="passwordManager.showPassword(${id})"]`).innerHTML = '👁️ Show';
                    }
                }
            }

            getStrengthColor(score) {
                if (score < 30) return '#e74c3c';
                if (score < 50) return '#f39c12';
                if (score < 70) return '#f1c40f';
                if (score < 90) return '#27ae60';
                return '#2ecc71';
            }

            renderRecentActivity() {
                const container = document.getElementById('recentActivity');
                const recentPasswords = this.passwords.slice(0, 5);
                
                if (recentPasswords.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: #7f8c8d; font-style: italic; padding: 40px;">No passwords generated yet. Create your first password to see activity here.</p>';
                    return;
                }

                container.innerHTML = `
                    <div style="background: #f8f9fa; border-radius: 10px; padding: 20px;">
                        ${recentPasswords.map(pwd => `
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #e9ecef;">
                                <div>
                                    <strong>${pwd.appName}</strong>
                                    <div style="font-size: 0.9rem; color: #7f8c8d;">${pwd.dateFormatted}</div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="color: ${this.getStrengthColor(pwd.strength.score)}; font-size: 0.9rem;">
                                        ${pwd.strength.level}
                                    </span>
                                    <button class="btn btn-primary btn-small" onclick="passwordManager.copyPasswordFromList('${pwd.password}')">Copy</button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            }

            searchPasswords(query) {
                const filteredPasswords = this.passwords.filter(pwd => 
                    pwd.appName.toLowerCase().includes(query.toLowerCase())
                );
                
                const container = document.getElementById('passwordsList');
                
                if (filteredPasswords.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: #7f8c8d; font-style: italic; padding: 40px;">No passwords found matching your search.</p>';
                    return;
                }

                container.innerHTML = filteredPasswords.map(pwd => `
                    <div class="password-item">
                        <div class="password-header">
                            <span class="app-name">🔗 ${pwd.appName}</span>
                            <span class="date-time">${pwd.dateFormatted}</span>
                        </div>
                        <div class="password-preview">
                            <span style="font-family: monospace; font-size: 1.1rem;">${'•'.repeat(pwd.password.length)}</span>
                            <button class="copy-btn" onclick="passwordManager.copyPasswordFromList('${pwd.password}')">Copy</button>
                        </div>
                        ${this.settings.showStrength ? `
                            <div style="margin: 10px 0;">
                                <small style="color: ${this.getStrengthColor(pwd.strength.score)};">
                                    Strength: ${pwd.strength.level} (${pwd.strength.score}%)
                                </small>
                                <div class="strength-meter" style="height: 4px; margin-top: 5px;">
                                    <div class="strength-bar" style="width: ${pwd.strength.score}%; background-color: ${this.getStrengthColor(pwd.strength.score)};"></div>
                                </div>
                            </div>
                        ` : ''}
                        <div class="password-actions">
                            <button class="btn btn-primary btn-small" onclick="passwordManager.showPassword(${pwd.id})">👁️ Show</button>
                            <button class="btn btn-danger btn-small" onclick="passwordManager.deletePassword(${pwd.id})">🗑️ Delete</button>
                        </div>
                    </div>
                `).join('');
            }

            exportPasswords() {
                if (this.passwords.length === 0) {
                    alert('No passwords to export!');
                    return;
                }

                const exportData = {
                    exportDate: new Date().toISOString(),
                    totalPasswords: this.passwords.length,
                    passwords: this.passwords.map(pwd => ({
                        appName: pwd.appName,
                        password: pwd.password,
                        strength: pwd.strength,
                        dateCreated: pwd.dateCreated
                    }))
                };

                const dataStr = JSON.stringify(exportData, null, 2);
                const dataBlob = new Blob([dataStr], { type: 'application/json' });
                
                const link = document.createElement('a');
                link.href = URL.createObjectURL(dataBlob);
                link.download = `passwords_backup_${new Date().toISOString().split('T')[0]}.json`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            clearAllPasswords() {
                this.passwords = [];
                localStorage.removeItem('savedPasswords');
                this.updateStats();
                this.renderPasswordsList();
                this.renderRecentActivity();
            }

            switchTab(tabName) {
                // Remove active class from all tabs and contents
                document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
                
                // Add active class to selected tab and content
                document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');
                document.getElementById(tabName).classList.add('active');
            }

            loadSettings() {
                document.getElementById('autoSave').checked = this.settings.autoSave;
                document.getElementById('showStrength').checked = this.settings.showStrength;
                document.getElementById('defaultLength').value = this.settings.defaultLength;
                document.getElementById('themeSelect').value = this.settings.theme;
                document.getElementById('passwordLength').value = this.settings.defaultLength;
                document.getElementById('lengthValue').textContent = this.settings.defaultLength;
                
                this.applyTheme(this.settings.theme);
            }

            saveSettings() {
                this.settings = {
                    autoSave: document.getElementById('autoSave').checked,
                    showStrength: document.getElementById('showStrength').checked,
                    defaultLength: parseInt(document.getElementById('defaultLength').value),
                    theme: document.getElementById('themeSelect').value
                };
                
                localStorage.setItem('appSettings', JSON.stringify(this.settings));
                this.applyTheme(this.settings.theme);
                this.renderPasswordsList();
                
                // Show success message
                const saveBtn = document.getElementById('saveSettings');
                const originalText = saveBtn.textContent;
                saveBtn.textContent = '✅ Saved!';
                saveBtn.style.background = 'linear-gradient(135deg, #27ae60, #229954)';
                
                setTimeout(() => {
                    saveBtn.textContent = originalText;
                    saveBtn.style.background = 'linear-gradient(135deg, #3498db, #2980b9)';
                }, 2000);
            }

            applyTheme(theme) {
                const themes = {
                    blue: 'linear-gradient(135deg, #1e3c72 0%, #2a5298 100%)',
                    dark: 'linear-gradient(135deg, #2c3e50 0%, #34495e 100%)',
                    green: 'linear-gradient(135deg, #134e5e 0%, #71b280 100%)',
                    purple: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'
                };
                
                document.body.style.background = themes[theme] || themes.blue;
            }

            // Advanced security features
            generateSecurePassword(length = 16) {
                // Use crypto.getRandomValues for cryptographically secure random numbers
                const array = new Uint8Array(length);
                crypto.getRandomValues(array);
                
                const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=[]{}|;:,.<>?';
                let password = '';
                
                for (let i = 0; i < length; i++) {
                    password += charset[array[i] % charset.length];
                }
                
                return password;
            }

            // Check for duplicate passwords
            isDuplicatePassword(password) {
                return this.passwords.some(pwd => pwd.password === password);
            }

            // Check for weak passwords
            getWeakPasswords() {
                return this.passwords.filter(pwd => pwd.strength.score < 50);
            }

            // Check for old passwords (older than 90 days)
            getOldPasswords() {
                const ninetyDaysAgo = new Date();
                ninetyDaysAgo.setDate(ninetyDaysAgo.getDate() - 90);
                
                return this.passwords.filter(pwd => new Date(pwd.dateCreated) < ninetyDaysAgo);
            }

            // Security audit
            runSecurityAudit() {
                const audit = {
                    totalPasswords: this.passwords.length,
                    weakPasswords: this.getWeakPasswords().length,
                    oldPasswords: this.getOldPasswords().length,
                    duplicatePasswords: 0, // Could implement duplicate checking
                    averageStrength: this.passwords.length > 0 ? 
                        Math.round(this.passwords.reduce((sum, p) => sum + p.strength.score, 0) / this.passwords.length) : 0
                };
                
                return audit;
            }
        }

        // Initialize the password manager when the page loads
        let passwordManager;
        document.addEventListener('DOMContentLoaded', () => {
            passwordManager = new PasswordManager();
        });

        // Add keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            // Ctrl/Cmd + G to generate password
            if ((e.ctrlKey || e.metaKey) && e.key === 'g') {
                e.preventDefault();
                passwordManager.generatePassword();
            }
            
            // Ctrl/Cmd + S to save password
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                if (!document.getElementById('saveBtn').disabled) {
                    passwordManager.savePassword();
                }
            }
            
            // Escape to clear search
            if (e.key === 'Escape') {
                document.getElementById('searchInput').value = '';
                passwordManager.renderPasswordsList();
            }
        });

        // Add service worker for offline functionality (if needed)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                // Service worker registration could be added here for offline support
            });
        }

        // Add auto-backup functionality
        setInterval(() => {
            // Auto-backup to localStorage every 5 minutes
            if (passwordManager && passwordManager.passwords.length > 0) {
                const backup = {
                    timestamp: new Date().toISOString(),
                    passwords: passwordManager.passwords,
                    settings: passwordManager.settings
                };
                localStorage.setItem('autoBackup', JSON.stringify(backup));
            }
        }, 300000); // 5 minutes

        // Add password breach checking (placeholder for future API integration)
        async function checkPasswordBreach(password) {
            // This would integrate with APIs like HaveIBeenPwned
            // For now, return false (not breached)
            return false;
        }

        // Add password history tracking
        function trackPasswordUsage(appName) {
            const usage = JSON.parse(localStorage.getItem('passwordUsage') || '{}');
            usage[appName] = (usage[appName] || 0) + 1;
            localStorage.setItem('passwordUsage', JSON.stringify(usage));
        }
    </script>
</body>
