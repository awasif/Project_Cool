                    <div className="space-y-4">
                        {roles.map(role => (
                            <div key={role.id} className="bg-gray-700 p-4 rounded-lg flex justify-between items-center">
                                <div>
                                    <h3 className="text-xl font-semibold text-white">{role.title}</h3>
                                    <p className="text-gray-300">{role.description}</p>
                                </div>
                                <div className="flex space-x-2">
                                    <Button onClick={() => handleEdit(role)} variant="secondary">Edit</Button>
                                    <Button onClick={() => handleDelete(role.id)} variant="danger">Delete</Button>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    );
};

// Customization Manager
const CustomizationManager = ({ db }) => {
    const [settings, setSettings] = useState({ name: '', bio: '', email: '', linkedin: '', github: '' });
    const [isLoading, setIsLoading] = useState(true);
    const [isSaving, setIsSaving] = useState(false);

    useEffect(() => {
        const settingsDoc = doc(db, 'customization', 'main');
        const unsubscribe = onSnapshot(settingsDoc, (doc) => {
            if (doc.exists()) {
                setSettings(doc.data());
            }
            setIsLoading(false);
        }, (error) => {
            console.error("Error fetching settings:", error);
            setIsLoading(false);
        });
        return () => unsubscribe();
    }, [db]);

    const handleInputChange = (e) => {
        const { id, value } = e.target;
        setSettings(prev => ({ ...prev, [id]: value }));
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        setIsSaving(true);
        try {
            await setDoc(doc(db, "customization", "main"), settings);
            alert('Settings updated successfully!');
        } catch (error) {
            console.error("Error updating settings:", error);
            alert('Failed to update settings.');
        } finally {
            setIsSaving(false);
        }
    };

    if (isLoading) {
        return <p>Loading customization settings...</p>;
    }

    return (
        <div className="bg-gray-800 p-6 rounded-lg shadow-xl">
            <h2 className="text-2xl font-bold mb-4 text-white">Website Customization</h2>
            <form onSubmit={handleSubmit} className="space-y-4">
                <FormInput id="name" label="Your Name" type="text" value={settings.name} onChange={handleInputChange} placeholder="e.g., Jane Doe" />
                <FormTextarea id="bio" label="Your Bio" value={settings.bio} onChange={handleInputChange} placeholder="A brief bio about yourself." />
                <h3 className="text-lg font-semibold pt-4 border-t border-gray-700">Contact & Socials</h3>
                <FormInput id="email" label="Email Address" type="email" value={settings.email} onChange={handleInputChange} placeholder="contact@example.com" />
                <FormInput id="linkedin" label="LinkedIn URL" type="text" value={settings.linkedin} onChange={handleInputChange} placeholder="https://linkedin.com/in/yourprofile" />
                <FormInput id="github" label="GitHub URL" type="text" value={settings.github} onChange={handleInputChange} placeholder="https://github.com/yourusername" />
                <Button type="submit" variant="primary" disabled={isSaving}>
                    {isSaving ? 'Saving...' : 'Save Changes'}
                </Button>
            </form>
        </div>
    );
};


export default App;
